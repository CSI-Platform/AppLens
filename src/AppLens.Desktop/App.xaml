<Application
    x:Class="AppLens.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Light">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <!-- Graphite ramp. The brand is silver and black, so the accent is the ink itself. -->
                    <SolidColorBrush x:Key="AppLensCanvas" Color="#FAFAFA"/>
                    <SolidColorBrush x:Key="AppLensSurface" Color="#FFFFFF"/>
                    <SolidColorBrush x:Key="AppLensRaised" Color="#F4F4F5"/>
                    <SolidColorBrush x:Key="AppLensInk" Color="#171717"/>
                    <SolidColorBrush x:Key="AppLensSecondary" Color="#525252"/>
                    <SolidColorBrush x:Key="AppLensMuted" Color="#737373"/>
                    <SolidColorBrush x:Key="AppLensEdge" Color="#171717" Opacity="0.08"/>
                    <SolidColorBrush x:Key="AppLensTrack" Color="#171717" Opacity="0.07"/>
                    <Color x:Key="SystemAccentColor">#171717</Color>
                    <Color x:Key="SystemAccentColorLight1">#2E2E2E</Color>
                    <Color x:Key="SystemAccentColorLight2">#404040</Color>
                    <Color x:Key="SystemAccentColorLight3">#525252</Color>
                    <Color x:Key="SystemAccentColorDark1">#171717</Color>
                    <Color x:Key="SystemAccentColorDark2">#0F0F0F</Color>
                    <Color x:Key="SystemAccentColorDark3">#000000</Color>
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="AppLensCanvas" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AppLensSurface" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AppLensRaised" Color="{ThemeResource SystemColorWindowColor}"/>
                    <SolidColorBrush x:Key="AppLensInk" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AppLensSecondary" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AppLensMuted" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AppLensEdge" Color="{ThemeResource SystemColorWindowTextColor}"/>
                    <SolidColorBrush x:Key="AppLensTrack" Color="{ThemeResource SystemColorWindowTextColor}"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <CornerRadius x:Key="ControlCornerRadius">4</CornerRadius>
            <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>

            <FontFamily x:Key="AppLensUiFontFamily">Segoe UI Variable Text, Segoe UI</FontFamily>
            <FontFamily x:Key="AppLensMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

            <Style TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppLensUiFontFamily}" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <Style x:Key="AppLensMonoTextBlockStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppLensMonoFontFamily}" />
                <Setter Property="FontSize" Value="12" />
            </Style>

            <Style x:Key="AppLensColumnHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource AppLensUiFontFamily}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource AppLensMuted}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
