<Window x:Class="AppLens.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AppLens">
 <ScrollViewer x:Name="PageScroll" RequestedTheme="Light" Background="{ThemeResource AppLensCanvas}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="ClientLayout_Changed">
 <Grid x:Name="RootGrid" Padding="24" RowSpacing="12" Loaded="Window_Loaded">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid x:Name="HeaderPanel" RowSpacing="12" SizeChanged="ClientLayout_Changed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Orientation="Horizontal" Spacing="16">
    <TextBlock Text="AppLens" FontSize="30" FontWeight="SemiBold" Foreground="{ThemeResource AppLensInk}"/>
    <TextBlock Text="Apps &amp; storage" VerticalAlignment="Center" Foreground="{ThemeResource AppLensMuted}"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="10">
     <Button x:Name="RunButton" Content="Scan this PC" Click="RunScan_Click" AccessKey="S" Background="{ThemeResource AppLensMetal}" BorderBrush="{ThemeResource AppLensEdge}"/>
     <Button x:Name="CancelButton" Content="Cancel scan" Click="CancelScan_Click" IsEnabled="False"/>
     <Button x:Name="DownloadReportButton" Click="ExportMarkdown_Click" IsEnabled="False" AccessKey="D" AutomationProperties.Name="Download report">
      <StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Download"/><TextBlock Text="Download report"/></StackPanel>
     </Button>
     <ComboBox x:Name="ReportFormat" SelectedIndex="0" AutomationProperties.Name="Report format"><ComboBoxItem Content="Markdown"/><ComboBoxItem Content="JSON"/><ComboBoxItem Content="HTML"/></ComboBox>
     <CheckBox x:Name="IncludeRawDetailsCheckBox" Content="Include personal identifiers" ToolTipService.ToolTip="Reports hide personal identifiers by default. Downloads include rows hidden by filters."/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border x:Name="StoragePanel" Grid.Row="1" Background="{ThemeResource AppLensSurface}" BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="0,1,0,1" Padding="12" SizeChanged="ClientLayout_Changed">
   <StackPanel Spacing="6">
    <TextBlock x:Name="DeviceText" Text="Run a scan to see disk usage and installed apps." TextWrapping="Wrap" Foreground="{ThemeResource AppLensInk}" FontSize="16"/>
    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed" Height="3"/>
    <TextBlock x:Name="StatusText" Text="Ready · Scans and reports stay on this device." TextWrapping="Wrap" Foreground="{ThemeResource AppLensMuted}" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </Border>
  <Grid x:Name="FiltersPanel" Grid.Row="2" RowSpacing="8" SizeChanged="ClientLayout_Changed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBox x:Name="SearchBox" PlaceholderText="Search apps or publishers" TextChanged="Search_Changed" AutomationProperties.Name="Search apps or publishers"/>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <ComboBox x:Name="SortFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Sort apps"><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Name Z–A"/><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Smallest first"/><ComboBoxItem Content="Publisher A–Z"/></ComboBox>
     <ComboBox x:Name="ScopeFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Installation scope"><ComboBoxItem Content="All scopes"/><ComboBoxItem Content="This user"/><ComboBoxItem Content="All users"/><ComboBoxItem Content="Unknown scope"/></ComboBox>
     <ComboBox x:Name="KindFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="App type"><ComboBoxItem Content="Apps"/><ComboBoxItem Content="All types"/><ComboBoxItem Content="Desktop apps"/><ComboBoxItem Content="Store apps"/><ComboBoxItem Content="Runtimes"/><ComboBoxItem Content="Updates"/><ComboBoxItem Content="Drivers"/><ComboBoxItem Content="System components"/></ComboBox>
     <ComboBox x:Name="RemovalFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Removal route"><ComboBoxItem Content="All removal routes"/><ComboBoxItem Content="Registered routes"/><ComboBoxItem Content="Windows Settings"/><ComboBoxItem Content="Restricted components"/></ComboBox>
     <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="{ThemeResource AppLensMuted}"/>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Grid x:Name="ResultsPanel" Grid.Row="3" Height="300" Background="{ThemeResource AppLensSurface}">
   <ListView x:Name="AppInventoryList" SelectionMode="Single" SelectionChanged="App_SelectionChanged" AutomationProperties.Name="Installed app results" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
    <ListView.Header>
     <Grid ColumnSpacing="12" Padding="16,10" Background="{ThemeResource AppLensMetal}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="105"/><ColumnDefinition Width="115"/><ColumnDefinition Width="185"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
      <TextBlock Text="Application / version" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="Publisher" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="Reported size" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="Scope" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="4" Text="Type" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="5" Text="Removal status" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Grid.Column="6" Text="Action" TextWrapping="Wrap" FontWeight="SemiBold"/>
     </Grid>
    </ListView.Header>
    <ListView.ItemTemplate>
     <DataTemplate>
      <Border BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="0,0,0,0.5" Padding="0,10">
       <Grid ColumnSpacing="12">
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="180"/><ColumnDefinition Width="130"/><ColumnDefinition Width="105"/><ColumnDefinition Width="115"/><ColumnDefinition Width="185"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
        <StackPanel Spacing="3"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Version}" TextWrapping="Wrap" FontSize="12" Foreground="{ThemeResource AppLensMuted}"/></StackPanel>
        <TextBlock Grid.Column="1" Text="{Binding Publisher}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Publisher}"/><TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding ScopeDisplay}" TextWrapping="Wrap"/><TextBlock Grid.Column="4" Text="{Binding KindDisplay}" TextWrapping="Wrap"/><TextBlock Grid.Column="5" Text="{Binding RemovalDisplay}" TextWrapping="Wrap" ToolTipService.ToolTip="{Binding RemovalReason}"/>
        <Button Grid.Column="6" Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Click="Remove_Click" AutomationProperties.Name="{Binding AccessibleAction}" ToolTipService.ToolTip="{Binding RemovalReason}"/>
       </Grid>
      </Border>
     </DataTemplate>
    </ListView.ItemTemplate>
   </ListView>
   <TextBlock x:Name="EmptyText" Text="Your app inventory will appear here." TextWrapping="Wrap" TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AppLensMuted}" IsHitTestVisible="False"/>
  </Grid>
  <StackPanel x:Name="DetailsPanel" Grid.Row="4" Spacing="4" SizeChanged="ClientLayout_Changed">
   <TextBlock Text="Reported sizes may differ from space recovered. Unknown sizes are listed last when sorting by size." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppLensMuted}"/>
   <Expander Header="App &amp; device details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <ScrollViewer MaxHeight="220"><StackPanel Spacing="12"><TextBlock x:Name="AppDetailsText" Text="Select an app to inspect its installation and removal details." TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="MachineDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></StackPanel></ScrollViewer>
   </Expander>
   <Expander Header="Action history" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <ScrollViewer MaxHeight="180"><TextBlock x:Name="HistoryText" Text="No actions in this session." TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
   </Expander>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</Window>
