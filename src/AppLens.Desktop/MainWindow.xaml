<Window x:Class="AppLens.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:AppLens.Desktop" Title="Installed">
 <ScrollViewer x:Name="PageScroll" Background="{ThemeResource AppLensCanvas}" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" SizeChanged="ClientLayout_Changed">
 <Grid x:Name="RootGrid" Padding="32,24,32,24" RowSpacing="16" Loaded="Window_Loaded">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

  <Grid x:Name="HeaderPanel" RowSpacing="16" SizeChanged="ClientLayout_Changed">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Spacing="4">
    <TextBlock Text="Installed" FontSize="28" FontWeight="Medium" Foreground="{ThemeResource AppLensInk}"/>
    <TextBlock Text="Your PC, ready for a workflow consultation." Foreground="{ThemeResource AppLensSecondary}"/>
    <TextBlock Text="1. Scan this PC   ·   2. Review your report   ·   3. Send it to your consultant" TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <Button x:Name="RunButton" Content="Scan this PC" Click="RunScan_Click" AccessKey="S" Style="{StaticResource AccentButtonStyle}" Padding="16,6"/>
     <Button x:Name="DiagnosticsButton" Content="Run diagnostics" Click="RunDiagnostics_Click" AccessKey="G"/>
     <Button x:Name="CancelButton" Content="Cancel scan" Click="CancelScan_Click" IsEnabled="False"/>
     <Border Width="1" Height="20" Margin="8,0" VerticalAlignment="Center" Background="{ThemeResource AppLensEdge}"/>
     <Button x:Name="ReviewReportButton" Content="Review report" Click="ReviewReport_Click" IsEnabled="False"/>
     <Button x:Name="ShareReportButton" Content="Send report…" Click="ShareReport_Click" IsEnabled="False" ToolTipService.ToolTip="Review your report, then choose an app and recipient in Windows sharing"/>
     <ComboBox x:Name="ReportFormat" SelectedIndex="0" AutomationProperties.Name="Report format"><ComboBoxItem Content="Markdown"/><ComboBoxItem Content="JSON"/><ComboBoxItem Content="HTML"/></ComboBox>
     <Button x:Name="DownloadReportButton" Click="ExportMarkdown_Click" IsEnabled="False" AccessKey="D" AutomationProperties.Name="Download report">
      <StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE896;" FontSize="16"/><TextBlock Text="Download report"/></StackPanel>
     </Button>
     <CheckBox x:Name="IncludeRawDetailsCheckBox" Content="Include personal identifiers" Margin="8,0,0,0" ToolTipService.ToolTip="Reports hide personal identifiers by default. Downloads include rows hidden by filters."/>
    </StackPanel>
   </ScrollViewer>
  </Grid>

  <Border x:Name="StoragePanel" Grid.Row="1" Background="{ThemeResource AppLensSurface}" BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="1" CornerRadius="8" Padding="20,16" SizeChanged="ClientLayout_Changed">
   <StackPanel Spacing="12">
    <TextBlock Text="Your PC at a glance" FontSize="18" FontWeight="SemiBold"/>
    <TextBlock x:Name="IntakeSummaryText" Text="A read-only scan will collect your PC specifications and installed tools. Nothing is sent automatically." TextWrapping="Wrap" IsTextSelectionEnabled="True"/>
    <TextBlock x:Name="DeviceText" Text="Drive usage appears after a scan" TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}"/>
    <ItemsControl x:Name="DiskList" IsTabStop="False">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="12"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate>
      <DataTemplate x:DataType="local:DiskRow">
       <Grid ColumnSpacing="16" HorizontalAlignment="Left" AutomationProperties.Name="{x:Bind AccessibleSummary}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="560"/><ColumnDefinition Width="48"/><ColumnDefinition Width="Auto" MinWidth="240"/></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Volume}" Style="{StaticResource AppLensMonoTextBlockStyle}" Foreground="{ThemeResource AppLensInk}" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" Height="8" CornerRadius="4" Background="{ThemeResource AppLensTrack}" VerticalAlignment="Center">
         <Grid.ColumnDefinitions><ColumnDefinition Width="{x:Bind UsedWidth}"/><ColumnDefinition Width="{x:Bind FreeWidth}"/></Grid.ColumnDefinitions>
         <Border Background="{ThemeResource AppLensInk}" CornerRadius="4"/>
        </Grid>
        <TextBlock Grid.Column="2" Text="{x:Bind PercentDisplay}" Style="{StaticResource AppLensMonoTextBlockStyle}" Foreground="{ThemeResource AppLensInk}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="3" Text="{x:Bind Figures}" Style="{StaticResource AppLensMonoTextBlockStyle}" Foreground="{ThemeResource AppLensSecondary}" VerticalAlignment="Center"/>
       </Grid>
      </DataTemplate>
     </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ProgressBar x:Name="ScanProgress" IsIndeterminate="True" Visibility="Collapsed"/>
    <StackPanel Spacing="4">
     <TextBlock x:Name="StatusText" Text="Ready" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppLensMuted}" AutomationProperties.LiveSetting="Polite"/>
     <TextBlock x:Name="ActionStatusText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="13" Foreground="{ThemeResource AppLensSecondary}" AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
   </StackPanel>
  </Border>

  <Grid x:Name="FiltersPanel" Grid.Row="2" ColumnSpacing="16" SizeChanged="ClientLayout_Changed">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <StackPanel Orientation="Horizontal" Spacing="8">
     <TextBox x:Name="SearchBox" Width="280" PlaceholderText="Search apps or publishers" TextChanged="Search_Changed" AutomationProperties.Name="Search apps or publishers"/>
     <ComboBox x:Name="SortFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Sort apps"><ComboBoxItem Content="Name A–Z"/><ComboBoxItem Content="Name Z–A"/><ComboBoxItem Content="Largest first"/><ComboBoxItem Content="Smallest first"/><ComboBoxItem Content="Publisher A–Z"/></ComboBox>
     <ComboBox x:Name="ScopeFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Installation scope"><ComboBoxItem Content="All scopes"/><ComboBoxItem Content="This user"/><ComboBoxItem Content="All users"/><ComboBoxItem Content="Unknown scope"/></ComboBox>
     <ComboBox x:Name="KindFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="App type"><ComboBoxItem Content="Apps"/><ComboBoxItem Content="All types"/><ComboBoxItem Content="Desktop apps"/><ComboBoxItem Content="Store apps"/><ComboBoxItem Content="Runtimes"/><ComboBoxItem Content="Updates"/><ComboBoxItem Content="Drivers"/><ComboBoxItem Content="System components"/></ComboBox>
     <ComboBox x:Name="RemovalFilter" SelectedIndex="0" SelectionChanged="Filter_Changed" AutomationProperties.Name="Removal route"><ComboBoxItem Content="All removal routes"/><ComboBoxItem Content="Registered routes"/><ComboBoxItem Content="Windows Settings"/><ComboBoxItem Content="Restricted components"/></ComboBox>
    </StackPanel>
   </ScrollViewer>
   <TextBlock x:Name="CountText" Grid.Column="1" VerticalAlignment="Center" FontSize="13" Foreground="{ThemeResource AppLensMuted}"/>
  </Grid>

  <Border x:Name="ResultsPanel" Grid.Row="3" Height="300" Background="{ThemeResource AppLensSurface}" BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="1" CornerRadius="8">
   <Grid>
    <ListView x:Name="AppInventoryList" SelectionMode="Single" SelectionChanged="App_SelectionChanged" AutomationProperties.Name="Installed app results" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollMode="Enabled">
     <ListView.Header>
      <Border BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="0,0,0,1" Padding="16,12,16,8">
       <Grid ColumnSpacing="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/><ColumnDefinition Width="96"/><ColumnDefinition Width="96"/><ColumnDefinition Width="112"/><ColumnDefinition Width="184"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
        <TextBlock Text="Application" Style="{StaticResource AppLensColumnHeaderStyle}"/><TextBlock Grid.Column="1" Text="Publisher" Style="{StaticResource AppLensColumnHeaderStyle}"/><TextBlock Grid.Column="2" Text="Size" TextAlignment="Right" Style="{StaticResource AppLensColumnHeaderStyle}"/><TextBlock Grid.Column="3" Text="Scope" Style="{StaticResource AppLensColumnHeaderStyle}"/><TextBlock Grid.Column="4" Text="Type" Style="{StaticResource AppLensColumnHeaderStyle}"/><TextBlock Grid.Column="5" Text="Removal" Style="{StaticResource AppLensColumnHeaderStyle}"/>
       </Grid>
      </Border>
     </ListView.Header>
     <ListView.ItemTemplate>
      <DataTemplate>
       <Border BorderBrush="{ThemeResource AppLensEdge}" BorderThickness="0,0,0,1" Padding="0,12">
        <Grid ColumnSpacing="16">
         <Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="180"/><ColumnDefinition Width="96"/><ColumnDefinition Width="96"/><ColumnDefinition Width="112"/><ColumnDefinition Width="184"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
         <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="Medium" Foreground="{ThemeResource AppLensInk}"/><TextBlock Text="{Binding Version}" TextWrapping="Wrap" Style="{StaticResource AppLensMonoTextBlockStyle}" FontSize="12" Foreground="{ThemeResource AppLensMuted}"/></StackPanel>
         <TextBlock Grid.Column="1" Text="{Binding PublisherDisplay}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Foreground="{ThemeResource AppLensSecondary}" ToolTipService.ToolTip="{Binding Publisher}"/>
         <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" TextAlignment="Right" Foreground="{ThemeResource AppLensInk}"/>
         <TextBlock Grid.Column="3" Text="{Binding ScopeDisplay}" TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}"/>
         <TextBlock Grid.Column="4" Text="{Binding KindDisplay}" TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}"/>
         <TextBlock Grid.Column="5" Text="{Binding RemovalDisplay}" TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}" ToolTipService.ToolTip="{Binding RemovalReason}"/>
         <Button Grid.Column="6" Content="{Binding ActionLabel}" IsEnabled="{Binding CanAct}" Click="Remove_Click" VerticalAlignment="Top" Margin="0,-4,0,-4" AutomationProperties.Name="{Binding AccessibleAction}" ToolTipService.ToolTip="{Binding RemovalReason}"/>
        </Grid>
       </Border>
      </DataTemplate>
     </ListView.ItemTemplate>
    </ListView>
    <TextBlock x:Name="EmptyText" Text="Scan this PC to list installed apps" TextWrapping="Wrap" TextAlignment="Center" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{ThemeResource AppLensMuted}" IsHitTestVisible="False"/>
   </Grid>
  </Border>

  <StackPanel x:Name="DetailsPanel" Grid.Row="4" Spacing="8" SizeChanged="ClientLayout_Changed">
   <Expander Header="Tell your consultant what you want to accomplish (optional)" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="12">
     <TextBox x:Name="WorkflowGoalBox" Header="What would you like to accomplish?" PlaceholderText="For example, turn customer emails into scheduled work" TextWrapping="Wrap" AcceptsReturn="True" MaxLength="2000" MaxHeight="120"/>
     <TextBox x:Name="WorkflowServicesBox" Header="Which tools or online services do you use?" PlaceholderText="Include services that may not be installed on this PC" TextWrapping="Wrap" MaxLength="2000"/>
     <TextBox x:Name="WorkflowConstraintsBox" Header="Any constraints or requirements?" PlaceholderText="For example, budget, offline use, or where work data may be stored" TextWrapping="Wrap" MaxLength="2000"/>
     <TextBlock Text="These notes are included in your report as your own statements. Do not include passwords or access keys." TextWrapping="Wrap" Foreground="{ThemeResource AppLensSecondary}"/>
    </StackPanel>
   </Expander>
   <TextBlock Text="Reported sizes may differ from space recovered. Unknown sizes are listed last when sorting by size." FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource AppLensMuted}"/>
   <Expander Header="App and device details" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <ScrollViewer MaxHeight="220"><StackPanel Spacing="12"><TextBlock x:Name="AppDetailsText" Text="Select an app to inspect its installation and removal details" TextWrapping="Wrap" IsTextSelectionEnabled="True"/><TextBlock x:Name="MachineDetailsText" TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource AppLensSecondary}"/></StackPanel></ScrollViewer>
   </Expander>
   <Expander Header="Action history" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
    <StackPanel Spacing="8">
     <Button x:Name="CheckStatusButton" Content="Check status" Click="CheckStatus_Click" IsEnabled="False" ToolTipService.ToolTip="Recheck recorded uninstall results without starting another uninstall"/>
     <ScrollViewer MaxHeight="180"><TextBlock x:Name="HistoryText" Text="No actions in this session" TextWrapping="Wrap" IsTextSelectionEnabled="True"/></ScrollViewer>
    </StackPanel>
   </Expander>
  </StackPanel>
 </Grid>
 </ScrollViewer>
</Window>
